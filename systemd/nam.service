[Unit]
Description=NAM - sing-box 节点 IP 访问控制
Documentation=https://github.com/ShawnMa123/NodeAccessManager
After=network-online.target sing-box.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nam daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
# 需要 root 才能读 sing-box 配置、写 /var/lib/nam 和 /run/nam.sock
User=root
AmbientCapabilities=
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
